<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  The droidian-fpd D-Bus API that webos-fingerprint-adapter consumes.

  Taken from droidian-fpd (https://github.com/droidian/droidian-fpd,
  src/fpdcommunity.h), which is the Droidian fork of
  sailfish-fpd-community; the interface is the community reimplementation
  of the Sailfish org.sailfishos.fingerprint1 API (v1) plus the Clear()
  community addition, renamed to org.droidian.fingerprint.

  One bus name on the system bus:
    org.droidian.fingerprint    /org/droidian/fingerprint    Fingerprint

  Methods returning "i" reply with an fpreply code:
    0 STARTED, 1 FAILED, 2 ALREADY_IDLE, 3 ALREADY_BUSY, 4 DENIED,
    5 KEY_ALREADY_EXISTS, 6 KEY_DOES_NOT_EXIST, 7 NO_KEYS_AVAILABLE,
    8 KEY_IS_INVALID
-->
<node>
<interface name="org.droidian.fingerprint">
    <method name="Enroll">
      <arg name="finger" type="s" direction="in"/>
      <arg name="reply" type="i" direction="out"/>
    </method>
    <method name="Identify">
      <arg name="reply" type="i" direction="out"/>
    </method>
    <method name="Verify">
      <arg name="reply" type="i" direction="out"/>
    </method>
    <method name="Abort">
      <arg name="reply" type="i" direction="out"/>
    </method>
    <method name="Remove">
      <arg name="finger" type="s" direction="in"/>
      <arg name="reply" type="i" direction="out"/>
    </method>
    <method name="Rename">
      <arg name="finger" type="s" direction="in"/>
      <arg name="newName" type="s" direction="in"/>
      <arg name="reply" type="i" direction="out"/>
    </method>
    <method name="Clear"/>
    <method name="GetState">
      <arg name="state" type="s" direction="out"/>
    </method>
    <method name="GetAll">
      <arg name="fingers" type="as" direction="out"/>
    </method>

    <signal name="Added">
      <arg name="finger" type="s"/>
    </signal>
    <signal name="Removed">
      <arg name="finger" type="s"/>
    </signal>
    <signal name="Identified">
      <arg name="finger" type="s"/>
    </signal>
    <signal name="Aborted"/>
    <signal name="Failed"/>
    <signal name="Verified"/>
    <signal name="StateChanged">
      <arg name="state" type="s"/>
    </signal>
    <signal name="EnrollProgressChanged">
      <arg name="progress" type="i"/>
    </signal>
    <signal name="AcquisitionInfo">
      <arg name="info" type="s"/>
    </signal>
    <signal name="ErrorInfo">
      <arg name="error" type="s"/>
    </signal>
    <signal name="ListChanged"/>
</interface>
</node>
