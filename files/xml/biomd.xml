<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  io.FuriOS.Biomd.Fingerprint, as exposed by FuriLabs' biomd on
  /io/FuriOS/Biomd/Fingerprint. Transcribed from the daemon's own
  introspection data.

  Unlike droidian-fpd, biomd carries the operation state, the enrolled
  finger list and the last error/acquisition code as properties, and its
  enums are integers rather than FPSTATE_*/FPERROR_*/FPACQUIRED_* strings.
  The translation back to those strings lives in fpd_client.c.
-->
<node>
  <interface name="io.FuriOS.Biomd.Fingerprint">
    <method name="Enroll">
      <arg name="finger_name" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="Identify">
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="StopEnroll">
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="StopIdentify">
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="RemoveFinger">
      <arg name="finger_name" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="RenameFinger">
      <arg name="old_name" type="s" direction="in"/>
      <arg name="new_name" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="GetFingerEnrollmentDate">
      <arg name="finger_name" type="s" direction="in"/>
      <arg name="enrollment_date" type="x" direction="out"/>
    </method>

    <signal name="StateChanged">
      <arg name="state" type="i"/>
    </signal>
    <signal name="EnrollmentProgressChanged">
      <arg name="progress" type="i"/>
    </signal>
    <signal name="EnrolledFingersChanged">
      <arg name="fingers" type="as"/>
    </signal>
    <signal name="ErrorInfoChanged">
      <arg name="error" type="i"/>
    </signal>
    <signal name="AcquisitionInfoChanged">
      <arg name="info" type="i"/>
    </signal>
    <signal name="Identified">
      <arg name="finger_name" type="s"/>
    </signal>

    <property name="State" type="i" access="read"/>
    <property name="EnrollmentProgress" type="i" access="read"/>
    <property name="EnrolledFingers" type="as" access="read"/>
    <property name="ErrorInfo" type="i" access="read"/>
    <property name="AcquisitionInfo" type="i" access="read"/>
    <property name="HardwareAvailable" type="b" access="read"/>
    <property name="ValidFingerNames" type="as" access="read"/>
  </interface>
</node>
